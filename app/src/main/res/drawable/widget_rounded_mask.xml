<?xml version="1.0" encoding="utf-8"?>
<!--
    A plain white rounded rect, used ONLY as an ImageView `src` for the
    Hebrew-date widget's background layer — never drawn as-is.

    White (not a real color) because the widget renderer tints it per-widget
    via ImageView.setColorFilter (RemoteViews' setInt(id, "setColorFilter",
    color) trick): SRC_ATOP over an opaque white shape replaces the color
    outright, so one drawable serves every WidgetColorPreset instead of one
    XML file per color. The layer's overall transparency is a second,
    independent setFloat("setAlpha", …) on the same ImageView — see
    WidgetRenderer.renderHebrewDateWidgets.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="20dp" />
</shape>
