<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome status-bar icon for the Women's Area notifications only: the
     area's logo reduced to its two shapes — an arch (the mikveh doorway) over
     two waves — so it still reads at 24dp. The full-colour logo
     (women_area_logo) is the notification's LARGE icon; Android draws a small
     icon from its alpha channel alone, so it cannot be the colour image.
     The app's own ic_stat_zman is untouched. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The arch: an outline, so it is a doorway and not a block. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M7,15V9.5a5,5 0,0 1,10 0V15zM9.6,15V9.5a2.4,2.4 0,0 1,4.8 0V15z"/>
    <!-- Two waves. Status-bar icons are tinted by the system from the alpha
         channel alone, so fixed white, like ic_stat_zman. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:pathData="M2.4,18.2q2.4,-2 4.8,0t4.8,0t4.8,0t4.8,0M2.4,21.6q2.4,-2 4.8,0t4.8,0t4.8,0t4.8,0"/>
</vector>
