<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget's שומר לערבית button once armed: fully opaque red with the gold
    ring the zmanim screen's badge gains — the app's existing "this is active"
    accent — so "it is set" reads without re-reading the words.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFD32F2F" />
    <corners android:radius="22dp" />
    <stroke
        android:width="2.5dp"
        android:color="#F5C518" />
</shape>
