<?xml version="1.0" encoding="utf-8"?>
<!--
    PREVIEW ONLY — the tile shown in the launcher's widget picker.

    This exists because a picker preview is inflated with NO data bound: the
    launcher renders the layout straight from resources, and the app never
    gets a chance to call setTextViewText on it. widget_zmanim.xml carries all
    its sample strings as tools:text, which AAPT strips at build time, so
    using it as the preview rendered an empty navy rectangle with a stray
    "00:00" from the Chronometer — the one surface where the widget has to
    sell itself showed nothing at all.

    Everything here is therefore REAL android:text, and the Chronometer is
    replaced by a plain TextView (a live Chronometer in a preview would count
    from an undefined base).

    Keep the visual structure in sync with widget_zmanim.xml when that layout
    changes — this file is deliberately static and will not follow it
    automatically.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Hebrew date + city -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="כ״ב אב תשפ״ו" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9FB3D9"
            android:textSize="13sp"
            android:maxLines="1"
            android:text="ירושלים" />
    </LinearLayout>

    <!-- Next zman + countdown -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#F5C518"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="הזמן הבא: מנחה קטנה" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:text="16:42" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:textColor="#D6E2FF"
            android:textSize="16sp"
            android:fontFeatureSettings="tnum"
            android:text="בעוד 3:54 שע׳" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:contentDescription="@null"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#EAF0FF"
            android:textSize="15sp"
            android:text="הנץ החמה" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:text="05:57" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#EAF0FF"
            android:textSize="15sp"
            android:text="סוף זמן ק״ש גר״א" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:text="09:21" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#EAF0FF"
            android:textSize="15sp"
            android:text="שקיעה" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:text="19:32" />
    </LinearLayout>
</LinearLayout>
