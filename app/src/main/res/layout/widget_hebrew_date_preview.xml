<?xml version="1.0" encoding="utf-8"?>
<!--
    PREVIEW ONLY — the tile shown in the launcher's widget picker. See the
    comment on widget_preview.xml for why this has to carry real android:text
    rather than the tools:text the real layout uses: a picker preview is
    inflated with no data bound.

    Static default look (navy, fully opaque) — the picker shows one
    illustrative tile regardless of what a user will later configure.
    android:tint does the same job here that ImageView.setColorFilter does at
    render time in WidgetRenderer, just fixed instead of per-widget.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_rounded_mask"
        android:tint="#123A8B"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layoutDirection="rtl"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:text="יום חמישי" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:text="י״ד" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="אלול" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:text="תשפ״ו" />
    </LinearLayout>
</FrameLayout>
