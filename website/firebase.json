{
  "hosting": {
    "target": "halacha-clock",
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "*.md"],
    "headers": [
      {
        "source": "**/*.@(png|jpg|jpeg|svg)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=604800" }]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
